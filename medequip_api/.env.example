PORT=5000
# Option A — recommended on Render/Neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
JWT_SECRET=change-this-to-a-long-random-secret

# Option B — separate fields (if DATABASE_URL is not used)
# DB_USER=...
# DB_PASSWORD=...
# DB_HOST=...
# DB_PORT=5432
# DB_NAME=neondb
